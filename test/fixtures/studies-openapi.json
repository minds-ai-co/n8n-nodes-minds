{
	"source": "https://getminds.ai/api/v1/openapi.json",
	"observedAt": "2026-09-14",
	"paths": {
		"/api/v1/studies": {
			"get": {
				"parameters": [
					{
						"in": "query",
						"name": "limit",
						"required": false,
						"description": "Max studies per page.",
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100,
							"default": 100
						}
					},
					{
						"in": "query",
						"name": "offset",
						"required": false,
						"description": "Number of studies to skip.",
						"schema": {
							"type": "integer",
							"minimum": 0,
							"default": 0
						}
					}
				],
				"responses": {
					"200": {
						"description": "A page of studies.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["data", "pagination"],
									"properties": {
										"data": {
											"type": "array",
											"items": {
												"$ref": "#/components/schemas/StudySummary"
											}
										},
										"pagination": {
											"$ref": "#/components/schemas/Pagination"
										}
									}
								}
							}
						}
					},
					"401": {
						"description": "Missing or invalid API key."
					},
					"500": {
						"description": "Internal server error."
					}
				},
				"operationId": "listStudies",
				"summary": "List studies",
				"description": "List Studies owned by the authenticated user. Each Study embeds its attached Audiences and their member Minds.",
				"tags": ["Studies"],
				"security": [
					{
						"ApiKeyAuth": []
					}
				]
			},
			"post": {
				"parameters": [],
				"responses": {
					"201": {
						"description": "Study created.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["data"],
									"properties": {
										"data": {
											"$ref": "#/components/schemas/StudyCreated"
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Missing `name`."
					},
					"401": {
						"description": "Missing or invalid API key."
					},
					"403": {
						"description": "Plan limit reached (`code: PLAN_LIMIT`)."
					},
					"404": {
						"description": "One or more Audience IDs were not found or are inaccessible to the caller."
					},
					"500": {
						"description": "Internal server error."
					}
				},
				"operationId": "createStudy",
				"summary": "Create a Study",
				"description": "Create a Study and optionally attach existing or newly created Audiences with audienceIds and audienceConfigs.",
				"tags": ["Studies"],
				"security": [
					{
						"ApiKeyAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["name"],
								"properties": {
									"name": {
										"type": "string",
										"description": "Study name."
									},
									"audienceIds": {
										"type": "array",
										"items": {
											"type": "string",
											"format": "uuid"
										},
										"description": "Audience IDs to attach. De-duplicated server-side."
									},
									"audienceConfigs": {
										"type": "array",
										"description": "Audiences to create atomically before attaching them to the Study.",
										"items": {
											"type": "object",
											"required": ["name", "mindIds"],
											"properties": {
												"name": {
													"type": "string"
												},
												"mindIds": {
													"type": "array",
													"items": {
														"type": "string",
														"format": "uuid"
													}
												}
											}
										}
									},
									"isLinkSharingEnabled": {
										"type": "boolean",
										"description": "Enable public link sharing for the Study and its attached Audiences/Minds."
									}
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/studies/{studyId}": {
			"get": {
				"parameters": [
					{
						"in": "path",
						"name": "studyId",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Study details.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["data"],
									"properties": {
										"data": {
											"$ref": "#/components/schemas/StudyDetail"
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Invalid study ID, or the Study is not in study mode."
					},
					"401": {
						"description": "Missing or invalid authentication."
					},
					"403": {
						"description": "The caller cannot access this study."
					},
					"404": {
						"description": "Study not found."
					}
				},
				"operationId": "getStudy",
				"summary": "Get a study",
				"description": "Return a Study with its attached audiences, Minds, and messages.",
				"tags": ["Studies"],
				"security": [
					{
						"ApiKeyAuth": []
					}
				]
			}
		},
		"/api/v1/studies/{studyId}/summary": {
			"get": {
				"parameters": [
					{
						"in": "path",
						"name": "studyId",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Persisted semantic summary.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["data"],
									"properties": {
										"data": {
											"type": "object"
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Study is not in study mode."
					},
					"401": {
						"description": "Unauthorized."
					},
					"403": {
						"description": "Study access denied."
					},
					"404": {
						"description": "Study not found."
					}
				},
				"operationId": "getStudySemanticSummary",
				"summary": "Get a study semantic summary",
				"description": "Return the persisted whole-study summary, semantic output blocks, staleness, and message coverage. Renderers are hints; consumers may introduce new UI logic without changing evidence contracts.",
				"tags": ["Studies", "Research"],
				"security": [
					{
						"ApiKeyAuth": []
					}
				]
			}
		},
		"/api/v1/studies/{studyId}/research-plans/preview": {
			"post": {
				"parameters": [
					{
						"in": "path",
						"name": "studyId",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Saved plan draft, per-question response contracts, and confirmation questions.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["data"],
									"properties": {
										"data": {
											"type": "object",
											"properties": {}
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Invalid request."
					},
					"401": {
						"description": "Unauthorized."
					},
					"403": {
						"description": "Study access denied."
					},
					"404": {
						"description": "Study or draft not found."
					},
					"409": {
						"description": "Draft revision conflict."
					}
				},
				"operationId": "previewStudyResearchPlan",
				"summary": "Preview or revise a study research plan",
				"description": "Let the research-planning model capture intent, main source, all attached assets, questions, optional methods, semantic outputs, missing inputs, confirmation questions, and a proposed response contract for every question. Clients can deterministically edit response formats and assign durable assets to exact questions. Pass `questions` instead of `request` to transcribe a fixed instrument exactly: text, order, ids, and per-item response contracts are stored as given and no planning model runs. Fetchable remote files are copied into durable Minds chat storage before the versioned draft is saved. Local file:// paths are not uploads. This endpoint never executes research.",
				"tags": ["Studies", "Research"],
				"security": [
					{
						"ApiKeyAuth": []
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"loadLatest": {
										"type": "boolean",
										"description": "Read the latest owned draft without planning or saving. Requires draftPlanId; cannot be combined with edits or planner inputs."
									},
									"edits": {
										"type": "object",
										"description": "Deterministic edits to a saved revision. Preserves methods and source policy; cannot be combined with planner inputs.",
										"additionalProperties": false,
										"properties": {
											"objective": {
												"type": "string",
												"maxLength": 2000
											},
											"promptContent": {
												"type": "string",
												"maxLength": 20000
											},
											"questions": {
												"type": "array",
												"minItems": 1,
												"maxItems": 200,
												"items": {
													"type": "object",
													"additionalProperties": false,
													"required": ["id", "moduleId", "text", "response"],
													"properties": {
														"id": {
															"type": "string"
														},
														"moduleId": {
															"type": "string"
														},
														"text": {
															"type": "string",
															"maxLength": 2000
														},
														"attachmentIds": {
															"type": "array",
															"items": {
																"type": "string"
															}
														}
													}
												}
											}
										}
									},
									"request": {
										"type": "string"
									},
									"studyLocale": {
										"type": "string",
										"enum": ["en", "es", "fr", "de", "zh", "tr", "ar", "ja", "ko"],
										"description": "Language used for the plan and its eventual study output."
									},
									"sourcePolicy": {
										"type": "string",
										"enum": ["request_only", "auto"],
										"default": "request_only",
										"description": "Evidence policy stored in this exact draft revision. request_only keeps a controlled Study closed to retrieved Mind documents and live web. auto is an explicit experimental opt-in to relevant Mind-knowledge retrieval; response-mode rules still control live web search."
									},
									"mindSourcePolicyOverrides": {
										"type": "array",
										"maxItems": 2000,
										"description": "Experimental checksum-locked Mind assignments. Each Mind UUID may appear once. Unlisted Minds use sourcePolicy; persisted knowledge_only locks remain stricter.",
										"items": {
											"type": "object",
											"required": ["mindId", "sourcePolicy"],
											"additionalProperties": false,
											"properties": {
												"mindId": {
													"type": "string",
													"format": "uuid"
												},
												"sourcePolicy": {
													"type": "string",
													"enum": ["request_only", "auto"]
												}
											}
										}
									},
									"source": {
										"type": "object",
										"description": "The main source. Prompt content is exact respondent-visible material and is separate from planner-only request text.",
										"properties": {
											"kind": {
												"type": "string",
												"enum": [
													"prompt",
													"website",
													"image",
													"video",
													"document",
													"questionnaire",
													"other"
												]
											},
											"label": {
												"type": "string"
											},
											"url": {
												"type": "string",
												"format": "uri"
											},
											"mimeType": {
												"type": "string"
											},
											"content": {
												"type": "string"
											}
										}
									},
									"attachments": {
										"type": "array",
										"description": "Files and website assets available to the confirmed run. Multi-asset blocks require complete question assignments and coverage of every asset. Empty lists explicitly mean no assets. Remote file URLs are durably imported; kind website remains a website.",
										"items": {
											"type": "object",
											"properties": {
												"kind": {
													"type": "string",
													"enum": ["website"]
												},
												"id": {
													"type": "string"
												},
												"name": {
													"type": "string"
												},
												"url": {
													"type": "string"
												},
												"path": {
													"type": "string"
												},
												"mimeType": {
													"type": "string"
												},
												"type": {
													"type": "string"
												}
											}
										}
									},
									"questionAttachments": {
										"type": "array",
										"description": "One-based question-to-attachment-id mapping. Multi-asset blocks require every question to be mapped and every asset to be used. Empty attachmentIds means no assets. Each question may appear at most once.",
										"items": {
											"type": "object",
											"required": ["questionNumber", "attachmentIds"],
											"additionalProperties": false,
											"properties": {
												"questionNumber": {
													"type": "integer",
													"minimum": 1
												},
												"attachmentIds": {
													"type": "array",
													"minItems": 0,
													"uniqueItems": true,
													"items": {
														"type": "string"
													}
												}
											}
										}
									},
									"suggestQuestionStimuli": {
										"type": "boolean",
										"description": "Default true. Lets the planner assign each attached file or website to one or more questions; the ids appear as attachmentIds on those questions. Pass false to keep questions unassigned unless questionAttachments names them."
									},
									"draftPlanId": {
										"type": "string",
										"format": "uuid"
									},
									"revision": {
										"type": "integer",
										"minimum": 1
									},
									"refinement": {
										"type": "string"
									},
									"answers": {
										"type": "object",
										"additionalProperties": {
											"type": "string"
										}
									},
									"questionResponses": {
										"type": "object",
										"description": "Explicit response-format edits keyed by question ID from the current draft."
									},
									"idempotencyKey": {
										"type": "string",
										"maxLength": 200,
										"description": "Retry-safety key. A repeated preview with the same key returns the draft revision the first attempt saved (`replayed: true`) instead of planning again. The `Idempotency-Key` header takes precedence."
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
