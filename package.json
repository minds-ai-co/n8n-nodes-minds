{
  "name": "n8n-nodes-minds",
  "version": "0.1.1",
  "description": "Official n8n community node for reviewable Minds research workflows.",
  "license": "MIT",
  "homepage": "https://getminds.ai",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "market-research",
    "synthetic-research",
    "minds"
  ],
  "author": {
    "name": "Minds",
    "email": "developers@getminds.ai",
    "url": "https://getminds.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minds-ai-co/n8n-nodes-minds.git"
  },
  "bugs": {
    "url": "https://github.com/minds-ai-co/n8n-nodes-minds/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run lint && npm run build && npm test",
    "prepublishOnly": "npm run verify"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples",
    "PUBLISHING.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/MindsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Minds/Minds.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.43.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
